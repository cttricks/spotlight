{
  "name": "spotlight-js",
  "version": "2.1.0",
  "description": "A smooth, modern, and zero-dependency site tour engine with declarative data-spot attributes, rich media, and adaptive themes.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/spotlight.min.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles": "./dist/styles/spotlight.css",
    "./styles/spotlight.css": "./dist/styles/spotlight.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css",
    "./dist/styles/*"
  ],
  "scripts": {
    "build": "tsup && npm run copy:assets",
    "prepublishOnly": "npm run build",
    "cdn": "serve dist -p 3000 --cors",
    "start": "serve example -p 3001",
    "site:dev": "npm --prefix website run dev",
    "site:build": "npm --prefix website run build",
    "site:preview": "npm --prefix website run preview",
    "clean": "rimraf dist",
    "copy:assets": "node -e \"const fs = require('fs'); fs.mkdirSync('dist/styles', { recursive: true }); fs.copyFileSync('src/styles/spotlight.css', 'dist/styles/spotlight.css'); fs.copyFileSync('src/styles/spotlight.css', 'example/spotlight.css'); if (fs.existsSync('dist/index.js')) fs.copyFileSync('dist/index.js', 'example/spotlight.js');\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cttricks/spotlight.js.git"
  },
  "keywords": [
    "spotlight",
    "tour",
    "guide",
    "onboarding",
    "product-tour",
    "walkthrough",
    "site-tour",
    "declarative",
    "typescript",
    "zero-dependency"
  ],
  "author": "Tanish Raj <help.cttricks@gmail.com>",
  "contributors": [
    "Tanish Raj <help.cttricks@gmail.com>"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/cttricks/spotlight.js/issues",
    "email": "help.cttricks@gmail.com"
  },
  "homepage": "https://spotlight-js.cttricks.com",
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "rimraf": "^5.0.5",
    "tsup": "^8.5.1",
    "typescript": "^5.5.0"
  },
  "files": [
    "dist",
    "SKILL.md"
  ]
}

